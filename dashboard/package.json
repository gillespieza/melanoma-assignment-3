{
  "name": "melanoma-digital-twin-dashboard",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Q5 clinical decision-support cockpit for the Melanoma Digital Twin project (UCD AI in Personalised Medicine).",
  "scripts": {
    "dev": "vite",
    "extract-palette": "python scripts/extract_palette.py",
    "build-cohort": "node scripts/build_cohort.mjs",
    "prebuild": "npm run extract-palette && npm run build-cohort",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@vercel/analytics": "^2.0.1",
    "framer-motion": "^11.3.19",
    "lucide-react": "^0.427.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "recharts": "^2.12.7",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "postcss": "^8.4.40",
    "tailwindcss": "^3.4.7",
    "typescript": "^5.5.4",
    "vite": "^5.4.0"
  }
}
